# Copia a .env y completa los datos de TU servicio TURN. .env no se versiona.
# No se activa TURN mientras TURN_URLS esté vacío.
TURN_URLS=
# Ejemplo de formato: turn:servidor.example:3478?transport=udp,turn:servidor.example:3478?transport=tcp,turns:servidor.example:5349?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
# Alternativa a usuario y contraseña: secreto TURN REST compatible con coturn.
TURN_SHARED_SECRET=
# true obliga a utilizar TURN para comprobar la ruta relay; requiere datos válidos.
TURN_RELAY_ONLY=false
# Metadatos locales, sin audio ni video. :memory: desactiva persistencia para pruebas.
# CALL_STATE_FILE=.data/calls.json
